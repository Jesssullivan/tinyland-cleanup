# GloriousFlywheel consumer front-door recipes.
#
# Include this file from a consumer repo Justfile:
#
#   import? "justfile.flywheel"
#
# The cache contract and Bazel wrapper are checked into this consumer repo.
# Runtime endpoints arrive through the invoking environment; this fragment
# never fetches private source, materializes credentials, or sources a
# repo-local environment file. It must not set global Just settings.

# Explain the current endpoint/profile classification without exposing values.
flywheel-doctor *args:
    @exec ./scripts/validation/bazel-cache-contract.sh {{args}}

# Fail unless the current shell is attached to a shared cache or executor.
flywheel-verify *args:
    @exec ./scripts/validation/bazel-cache-contract.sh --strict {{args}}

# Run the GloriousFlywheel Bazel wrapper directly.
flywheel-bazel command *args:
    @exec ./scripts/gloriousflywheel-bazel.sh "{{command}}" {{args}}

# Cache-backed Bazel build through the wrapper.
flywheel-build *targets:
    @exec ./scripts/gloriousflywheel-bazel.sh build {{targets}}

# Cache-backed Bazel test through the wrapper.
flywheel-test *targets:
    @exec ./scripts/gloriousflywheel-bazel.sh test {{targets}}

# Cache-backed Bazel fetch through the wrapper.
flywheel-fetch *targets:
    @exec ./scripts/gloriousflywheel-bazel.sh fetch {{targets}}

# Print Bazel info through the wrapper after profile validation.
flywheel-info *args:
    @exec ./scripts/gloriousflywheel-bazel.sh info {{args}}
